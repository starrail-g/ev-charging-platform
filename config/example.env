# 复制为 config/local.env（已被 .gitignore）后按需填写：
#   Copy-Item config/example.env config/local.env   (Windows)
#   cp config/example.env config/local.env          (Ubuntu)
# local.env 与真实密钥永不进入 Git、日志、截图或测试快照。

EV_SERVER_HOST=127.0.0.1
EV_SERVER_PORT=45454
EV_DATABASE_PATH=var/ev-charging.db
EV_SCHEMA_PATH=database/schema/schema.sql
EV_DATABASE_SEED_PATH=database/seeds/dev.sql

# 腾讯地图开发配置（本地专用，永不提交真实凭据）：
# TENCENT_MAP_KEY 留空 = Web 大屏自动使用离线 SVG 拓扑图；
# 环境变量 TENCENT_MAP_KEY 优先于本文件。
# TENCENT_MAP_ENABLED=0 可强制走确定性的离线降级路径（本地调试开关）。
TENCENT_MAP_KEY=
TENCENT_MAP_ENABLED=1

# 本地演示服务端口（dashboard/serve.py 默认 8080，可用 --port 覆盖）。
DASHBOARD_PORT=8080
